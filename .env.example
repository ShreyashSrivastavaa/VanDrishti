# General
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forestwatch
DATABASE_SSL=false

# API
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
ENABLE_USER_ANALYSIS=false
MAX_USER_AOI_KM2=100
MAX_QUEUED_JOBS=20
DAILY_JOBS_PER_IP=3
IP_HASH_SALT=development_salt_key_do_not_use_in_prod

# Geocoding (Nominatim proxy)
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=ForestWatchAI/0.1 (contact: admin@forestwatch.org)

# Imagery Providers
IMAGERY_PROVIDER=earth-search
EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
MAX_SCENE_CLOUD_COVER=60
MIN_VALID_FRACTION=0.70

# Storage
ARTIFACT_STORE=local
ARTIFACT_LOCAL_DIR=./data/artifacts
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ARTIFACT_PUBLIC_BASE_URL=

# Worker / ML
WORKER_CONCURRENCY=1
MODEL_DEVICE=cpu
ACTIVE_MODEL_NAME=spectral_baseline
ACTIVE_MODEL_VERSION=1.0.0

# Web (VITE_ prefix = public, never put secrets here)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_SUPPORT_URL=
VITE_SITE_CONTACT_EMAIL=info@forestwatch.org
